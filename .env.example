DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baesh_v2?schema=public"
# Production refuses to start unless this is a unique random value of 32+ chars (e.g. `openssl rand -hex 48`).
JWT_SECRET="replace-with-a-long-random-secret"
# Local development only: seed company/institution/admin demo accounts with their privileged roles.
SEED_PRIVILEGED_DEMO_ACCOUNTS="false"
SEED_DEMO_PASSWORD=""
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,http://127.0.0.1:5173"
VITE_API_URL="http://localhost:4000/api"
PORT=4000
NODE_ENV="development"
# AI: "mock" uses deterministic rule-based output (no external calls). "openai" / "upstage" need the matching key.
# Keys are server-side only and never logged; upstream error messages are redacted before storage.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
UPSTAGE_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# UPSTAGE_BASE_URL="https://api.upstage.ai/v1"
# AI_MODEL="gpt-4o-mini"            # default: gpt-4o-mini (openai) / solar-pro2 (upstage)
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_LIMIT_PER_USER=30
# Calls are refused for the rest of the month once logged cost reaches this amount.
# AI_MONTHLY_BUDGET_USD=50
# Override token prices (USD per 1M tokens) for models missing from the built-in price table.
# AI_PRICE_INPUT_PER_1M=0.15
# AI_PRICE_OUTPUT_PER_1M=0.6
# Result report / portfolio PDFs are rendered with Playwright Chromium.
# On the server: `npx playwright install --with-deps chromium` and a Korean font (e.g. `apt install fonts-noto-cjk`).
REPORT_RENDER_TIMEOUT_MS=60000
# Evidence file storage. Files are always private; access goes through short-lived signed URLs.
# "local" stores under STORAGE_LOCAL_DIR (development); use "s3" in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/private"
# S3: the bucket must block public access. Credentials come from the standard AWS chain (IAM role or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
S3_BUCKET=""
S3_REGION="ap-northeast-2"
# S3_ENDPOINT="https://s3.example.com"  # only for S3-compatible storage (MinIO, R2 ...)
FILE_URL_TTL_SECONDS=300
# Public media (post photos/videos, avatars, covers). Uploads are re-encoded to WebP with a thumbnail.
# local: written to MEDIA_LOCAL_DIR and served at {API_PUBLIC_URL}/media.
# s3: written under the "media/" prefix of MEDIA_S3_BUCKET (default S3_BUCKET) and served through a CDN
#     (e.g. CloudFront with origin access control mapping /media/* to that prefix). MEDIA_PUBLIC_BASE_URL is required.
API_PUBLIC_URL="http://localhost:4000"
MEDIA_LOCAL_DIR="./storage/media"
MEDIA_S3_BUCKET=""
# MEDIA_PUBLIC_BASE_URL="https://cdn.example.com/media"
# ClamAV daemon (clamd) for malware scanning. With MALWARE_SCAN_REQUIRED="true", uploads are rejected when the scanner is unreachable.
CLAMAV_HOST=""
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED="false"

# ---- Security / sessions ----
# Number of reverse proxies in front of the API (nginx = 1). Required for correct client IPs and rate limits.
TRUST_PROXY=0
SESSION_TTL_HOURS=168
# Sessions unused for this long are signed out.
SESSION_IDLE_HOURS=72
# Production refuses to start with RATE_LIMIT_ENABLED="false".
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_GLOBAL_PER_MIN=300

# ---- Billing / onboarding ----
# enforce: plan limits block new work (HTTP 402) · warn: limits are reported only.
BILLING_ENFORCEMENT="enforce"
# Trial given automatically when an organization is approved without a contract.
BILLING_TRIAL_DAYS=60
INVITE_TTL_DAYS=14
# log: invitation emails are only logged (links are shown to the inviting admin) · ses: Amazon SES.
MAIL_DRIVER="log"
MAIL_FROM="BAESH <no-reply@baesh.kr>"
SES_REGION="ap-northeast-2"

# ---- Operations / monitoring ----
# Shared secret (32+ chars) that backup/restore/deploy scripts use to report runs to /api/ops/runs.
OPS_INGEST_TOKEN=""
# Slack/Discord-compatible incoming webhook for operational alerts (5xx spikes, backup failures, AI cost).
ALERT_WEBHOOK_URL=""
# AI_DAILY_COST_ALERT_USD=20
# SENTRY_DSN="https://<key>@o0.ingest.sentry.io/0"
# Injected by deploy.sh (git sha / environment). Shown in /api/health/ready and the ops console.
APP_VERSION="dev"
APP_ENV="local"
# Hourly jobs (subscription expiry, invoice overdue, retention, ops checks). Enable on exactly one instance.
JOBS_ENABLED="true"
# Used by deploy/scripts/backup-db.sh and restore-drill.sh (read from shared/backend.env on the server).
BACKUP_S3_BUCKET=""

# ---- Tests ----
# vitest uses its own database (created/migrated automatically). Never point this at real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baesh_v2_test?schema=public"
