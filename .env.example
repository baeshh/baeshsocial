DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baesh_v2?schema=public"
# Production refuses to start unless this is a unique random value of 32+ chars (e.g. `openssl rand -hex 48`).
JWT_SECRET="replace-with-a-long-random-secret"
# Local development only: seed company/institution/admin demo accounts with their privileged roles.
SEED_PRIVILEGED_DEMO_ACCOUNTS="false"
SEED_DEMO_PASSWORD=""
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,http://127.0.0.1:5173"
VITE_API_URL="http://localhost:4000/api"
PORT=4000
NODE_ENV="development"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
UPSTAGE_API_KEY=""
# Evidence file storage. Files are always private; access goes through short-lived signed URLs.
# "local" stores under STORAGE_LOCAL_DIR (development); use "s3" in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/private"
# S3: the bucket must block public access. Credentials come from the standard AWS chain (IAM role or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
S3_BUCKET=""
S3_REGION="ap-northeast-2"
# S3_ENDPOINT="https://s3.example.com"  # only for S3-compatible storage (MinIO, R2 ...)
FILE_URL_TTL_SECONDS=300
# Public media (post photos/videos, avatars, covers). Uploads are re-encoded to WebP with a thumbnail.
# local: written to MEDIA_LOCAL_DIR and served at {API_PUBLIC_URL}/media.
# s3: written under the "media/" prefix of MEDIA_S3_BUCKET (default S3_BUCKET) and served through a CDN
#     (e.g. CloudFront with origin access control mapping /media/* to that prefix). MEDIA_PUBLIC_BASE_URL is required.
API_PUBLIC_URL="http://localhost:4000"
MEDIA_LOCAL_DIR="./storage/media"
MEDIA_S3_BUCKET=""
# MEDIA_PUBLIC_BASE_URL="https://cdn.example.com/media"
# ClamAV daemon (clamd) for malware scanning. With MALWARE_SCAN_REQUIRED="true", uploads are rejected when the scanner is unreachable.
CLAMAV_HOST=""
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED="false"
