# Instance = environment: baesh-backup@production.service
[Unit]
Description=BAESH %i database backup to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=baesh
Environment=BAESH_ENV=%i
Environment=BACKUP_LABEL=scheduled
ExecStart=/srv/baesh/%i/current/deploy/scripts/backup-db.sh
Nice=10
IOSchedulingClass=idle
