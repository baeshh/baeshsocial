generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  COMPANY
  INSTITUTION
  ADMIN
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectVisibility {
  PRIVATE
  TEAM
  PUBLIC
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProjectActivityType {
  UPDATE
  TASK
  FILE
  MILESTONE
  INSIGHT
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum OpportunityType {
  JOB
  INTERNSHIP
  HACKATHON
  EDUCATION
  COMPETITION
  STARTUP_PROGRAM
}

enum AIAnalysisType {
  PROFILE_INSIGHT
  PROJECT_INSIGHT
  OPPORTUNITY_MATCH
  PORTFOLIO_GENERATOR
  REPORT_NARRATIVE
  TALENT_MATCH_EXPLANATION
}

enum AIUsageStatus {
  SUCCESS
  INVALID_OUTPUT
  PROVIDER_ERROR
  TIMEOUT
  RATE_LIMITED
  BUDGET_EXCEEDED
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

enum MatchFeedback {
  SHORTLISTED
  CONTACTED
  NOT_A_FIT
}

enum VerifiedRecordEventAction {
  ISSUED
  REVOKED
  REISSUED
}

enum OrganizationType {
  COMPANY
  UNIVERSITY
  INSTITUTION
  COMMUNITY
}

enum OrganizationVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum OrganizationMemberStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum OrganizationDocumentType {
  BUSINESS_REGISTRATION
  EMPLOYMENT_CERTIFICATE
  OFFICIAL_LETTER
  OTHER
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum EvidenceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EvidenceCategory {
  DEVELOPMENT
  MEETING
  PRESENTATION
  RESEARCH
  FIELDWORK
  REPORT
  OTHER
}

enum EvidenceFileKind {
  IMAGE
  VIDEO
  PDF
}

enum EvidenceReviewAction {
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  REVOKED
}

enum VerifiedRecordStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum OpportunityEnrollmentStatus {
  APPLIED
  ENROLLED
  COMPLETED
  REJECTED
  WITHDRAWN
}

enum CertificateSource {
  MANUAL
  PROGRAM
}

enum NotificationType {
  SYSTEM
  PROJECT
  PROJECT_INVITE
  OPPORTUNITY
  MESSAGE
  AI
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  FOLLOW
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  FOLLOWERS
}

enum ProjectLinkType {
  GITHUB
  FIGMA
  NOTION
  GOOGLE_DRIVE
  DEPLOYMENT
  OTHER
}

enum ProjectInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id                       String                     @id @default(cuid())
  email                    String                     @unique
  password                 String
  name                     String
  role                     UserRole                   @default(USER)
  avatarUrl                String?
  coverUrl                 String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  profile                  Profile?
  ownedProjects            Project[]                  @relation("ProjectOwner")
  projectMemberships       ProjectMember[]
  sentProjectInvites       ProjectInvite[]            @relation("ProjectInviteInviter")
  receivedProjectInvites   ProjectInvite[]            @relation("ProjectInviteInvitee")
  assignedTasks            ProjectTask[]              @relation("TaskAssignee")
  projectActivities        ProjectActivity[]
  uploadedFiles            ProjectFile[]              @relation("FileUploader")
  posts                    Post[]                     @relation("PostAuthor")
  postLikes                PostLike[]
  commentLikes             CommentLike[]
  comments                 Comment[]
  opportunitiesCreated     Opportunity[]              @relation("OpportunityCreator")
  savedOpportunities       SavedOpportunity[]
  verifiedRecords          VerifiedRecord[]
  aiAnalyses               AIAnalysis[]
  notifications            Notification[]
  sentMessages             Message[]                  @relation("SentMessages")
  receivedMessages         Message[]                  @relation("ReceivedMessages")
  following                UserFollow[]               @relation("UserFollowsFollower")
  followers                UserFollow[]               @relation("UserFollowsFollowing")
  profileViewsMade         ProfileView[]              @relation("ProfileViewsAsViewer")
  profileViewsReceived     ProfileView[]              @relation("ProfileViewsAsProfile")
  triggeredNotifications   Notification[]             @relation("NotificationActor")
  opportunityEnrollments   OpportunityEnrollment[]    @relation("EnrollmentUser")
  approvedEnrollments      OpportunityEnrollment[]    @relation("EnrollmentApprover")
  organizationMemberships  OrganizationMember[]
  organizationsCreated     Organization[]             @relation("OrganizationCreator")
  submittedVerifications   OrganizationVerification[] @relation("VerificationSubmitter")
  reviewedVerifications    OrganizationVerification[] @relation("VerificationReviewer")
  programsCreated          Program[]                  @relation("ProgramCreator")
  managedPrograms          ProgramManager[]
  programParticipations    ProgramParticipant[]       @relation("ProgramParticipantUser")
  programParticipantsAdded ProgramParticipant[]       @relation("ProgramParticipantAddedBy")
  evidenceAuthored         ProjectEvidence[]          @relation("EvidenceAuthor")
  evidenceReviewed         ProjectEvidence[]          @relation("EvidenceReviewer")
  evidenceFilesUploaded    EvidenceFile[]             @relation("EvidenceFileUploader")
  evidenceReviewActions    EvidenceReview[]           @relation("EvidenceReviewActor")
  projectLinksCreated      ProjectExternalLink[]      @relation("ProjectLinkCreator")
  recordsVerified          VerifiedRecord[]           @relation("VerifiedRecordVerifier")
  recordsRevoked           VerifiedRecord[]           @relation("VerifiedRecordRevoker")
  verifiedRecordEvents     VerifiedRecordEvent[]
  aiUsageLogs              AIUsageLog[]
  reportTemplatesCreated   ReportTemplate[]
  reportsCreated           GeneratedReport[]
  talentSearches           TalentSearch[]
  matchResults             MatchResult[]              @relation("MatchCandidate")
  matchFeedbackGiven       MatchResult[]              @relation("MatchFeedbackBy")

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
}

model Profile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  headline            String?
  bio                 String?
  school              String?
  company             String?
  location            String?
  skills              String[]          @default([])
  interests           String[]          @default([])
  socialLinks         Json?
  trustScore          Int               @default(0)
  verified            Boolean           @default(false)
  /// Who can see projects, history and posts on the profile. Name/avatar/headline stay visible to members.
  visibility          ProfileVisibility @default(PUBLIC)
  /// Ordered, at most 3. Only projects the user owns or belongs to are accepted.
  featuredProjectIds  String[]          @default([])
  /// Explicit consent to appear in company talent search. Only public projects and verified records are shared.
  talentSearchOptIn   Boolean           @default(false)
  talentSearchOptInAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificates        Certificate[]
  careers             Career[]
  awards              Award[]
  portfolios          Portfolio[]

  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_headline_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_company_trgm_idx")
  @@index([school(ops: raw("gin_trgm_ops"))], type: Gin, map: "Profile_school_trgm_idx")
  @@index([skills], type: Gin)
}

model Certificate {
  id            String                 @id @default(cuid())
  profileId     String
  title         String
  issuer        String
  issuedAt      DateTime?
  credentialUrl String?
  verified      Boolean                @default(false)
  source        CertificateSource      @default(MANUAL)
  opportunityId String?                @unique
  profile       Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  enrollment    OpportunityEnrollment?

  @@index([profileId, issuedAt])
}

model Career {
  id          String    @id @default(cuid())
  profileId   String
  company     String
  position    String
  startDate   DateTime?
  endDate     DateTime?
  description String?
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
}

model Award {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  issuer      String?
  awardedAt   DateTime?
  description String?
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, awardedAt])
}

model Portfolio {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  description String?
  url         String?
  imageUrl    String?
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id              String                @id @default(cuid())
  title           String
  slug            String                @unique
  description     String?
  objective       String?
  readme          String?
  ownerId         String
  status          ProjectStatus         @default(PLANNING)
  progress        Int                   @default(0)
  visibility      ProjectVisibility     @default(PRIVATE)
  skills          String[]              @default([])
  programId       String?
  teamName        String?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  owner           User                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  program         Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  evidence        ProjectEvidence[]
  roles           ProjectRole[]
  members         ProjectMember[]
  invites         ProjectInvite[]
  tasks           ProjectTask[]
  activities      ProjectActivity[]
  files           ProjectFile[]
  posts           Post[]
  verifiedRecords VerifiedRecord[]
  aiAnalyses      AIAnalysis[]
  externalLinks   ProjectExternalLink[]

  @@index([programId])
  @@index([ownerId, updatedAt])
  @@index([visibility, updatedAt])
}

/// User-registered links to outside tools. A link is never evidence of verified work by itself;
/// verification only comes from the institution evidence review flow.
model ProjectExternalLink {
  id          String          @id @default(cuid())
  projectId   String
  type        ProjectLinkType
  url         String
  label       String?
  description String?
  /// Parsed identifiers (e.g. GitHub owner/repo) kept for the future sync integration.
  metadata    Json?
  sortOrder   Int             @default(0)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("ProjectLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, url])
  @@index([projectId, sortOrder])
}

model ProjectRole {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  slug        String
  description String?
  permissions String[]
  isSystem    Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  invites     ProjectInvite[]

  @@unique([projectId, slug])
}

model ProjectMember {
  id           String       @id @default(cuid())
  projectId    String
  userId       String
  roleId       String?
  role         String
  contribution String?
  joinedAt     DateTime     @default(now())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole  ProjectRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvite {
  id           String              @id @default(cuid())
  projectId    String
  inviterId    String
  inviteeId    String
  roleId       String?
  role         String
  contribution String?
  status       ProjectInviteStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  respondedAt  DateTime?
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter      User                @relation("ProjectInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee      User                @relation("ProjectInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  projectRole  ProjectRole?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([projectId, inviteeId])
}

model ProjectTask {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectTaskStatus @default(TODO)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId, createdAt])
}

model ProjectActivity {
  id          String              @id @default(cuid())
  projectId   String
  userId      String
  type        ProjectActivityType @default(UPDATE)
  title       String
  description String?
  createdAt   DateTime            @default(now())
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  url        String
  fileType   String
  uploadedBy String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User     @relation("FileUploader", fields: [uploadedBy], references: [id])

  @@index([projectId, createdAt])
}

model Post {
  id              String         @id @default(cuid())
  authorId        String
  content         String
  linkedProjectId String?
  repostOfId      String?
  mediaUrls       String[]       @default([])
  visibility      PostVisibility @default(PUBLIC)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  author          User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  linkedProject   Project?       @relation(fields: [linkedProjectId], references: [id])
  repostOf        Post?          @relation("PostRepostOf", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts         Post[]         @relation("PostRepostOf")
  likes           PostLike[]
  comments        Comment[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([repostOfId])
  @@index([linkedProjectId])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowsFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowsFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model ProfileView {
  viewerId      String
  profileUserId String
  viewCount     Int      @default(1)
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @updatedAt
  viewer        User     @relation("ProfileViewsAsViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profileUser   User     @relation("ProfileViewsAsProfile", fields: [profileUserId], references: [id], onDelete: Cascade)

  @@id([viewerId, profileUserId])
  @@index([viewerId, lastViewedAt(sort: Desc)])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([parentId])
  @@index([postId, createdAt])
  @@index([authorId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Opportunity {
  id                 String                  @id @default(cuid())
  title              String
  type               OpportunityType
  organization       String
  description        String
  skills             String[]                @default([])
  location           String?
  isRemote           Boolean                 @default(false)
  deadline           DateTime?
  applyUrl           String?
  createdBy          String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  creator            User?                   @relation("OpportunityCreator", fields: [createdBy], references: [id])
  savedOpportunities SavedOpportunity[]
  enrollments        OpportunityEnrollment[]
  certificates       Certificate[]
}

model OpportunityEnrollment {
  id            String                      @id @default(cuid())
  userId        String
  opportunityId String
  status        OpportunityEnrollmentStatus @default(APPLIED)
  appliedAt     DateTime                    @default(now())
  enrolledAt    DateTime?
  completedAt   DateTime?
  approvedById  String?
  certificateId String?                     @unique
  user          User                        @relation("EnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  approver      User?                       @relation("EnrollmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  certificate   Certificate?                @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@unique([userId, opportunityId])
  @@index([opportunityId])
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

/// Institution-issued proof of project work. Displayed content comes from the frozen `snapshot`
/// (hashed into `contentHash`), never from live project/evidence rows the user can still edit.
model VerifiedRecord {
  id                  String                @id @default(cuid())
  userId              String
  projectId           String
  role                String
  contributionSummary String
  evidenceUrl         String?
  evidenceId          String?               @unique
  trustScore          Int                   @default(0)
  issuedAt            DateTime              @default(now())
  status              VerifiedRecordStatus  @default(PENDING)
  organizationId      String?
  programId           String?
  verifiedById        String?
  verifiedAt          DateTime?
  revokedAt           DateTime?
  revokedById         String?
  revokeReason        String?
  snapshot            Json?
  contentHash         String?
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence            ProjectEvidence?      @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  program             Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  verifiedBy          User?                 @relation("VerifiedRecordVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  revokedBy           User?                 @relation("VerifiedRecordRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  events              VerifiedRecordEvent[]

  @@index([userId, issuedAt])
  @@index([userId, status])
  @@index([projectId])
  @@index([organizationId, status])
}

/// Append-only history of issue / revoke / reissue decisions on a verified record.
model VerifiedRecordEvent {
  id          String                    @id @default(cuid())
  recordId    String
  action      VerifiedRecordEventAction
  actorId     String?
  reason      String?
  contentHash String?
  createdAt   DateTime                  @default(now())
  record      VerifiedRecord            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor       User?                     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
}

model AIAnalysis {
  id             String         @id @default(cuid())
  userId         String
  projectId      String?
  organizationId String?
  type           AIAnalysisType
  input          Json
  output         Json
  provider       String
  model          String
  promptVersion  String?
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Decimal?       @db.Decimal(12, 6)
  latencyMs      Int?
  /// Grounding check result: which claims were kept/dropped and why.
  validation     Json?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
}

/// One row per LLM call attempt group (including failures) for cost, quota and error monitoring.
model AIUsageLog {
  id               String        @id @default(cuid())
  userId           String?
  organizationId   String?
  feature          String
  provider         String
  model            String
  status           AIUsageStatus
  attempts         Int           @default(1)
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  costUsd          Decimal       @default(0) @db.Decimal(12, 6)
  latencyMs        Int           @default(0)
  validationIssues Int           @default(0)
  errorCode        String?
  errorMessage     String?
  analysisId       String?
  createdAt        DateTime      @default(now())
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

/// Report layout definition. organizationId null = BAESH default template.
model ReportTemplate {
  id             String            @id @default(cuid())
  organizationId String?
  key            String
  name           String
  version        Int               @default(1)
  sections       Json
  isDefault      Boolean           @default(false)
  createdById    String?
  createdAt      DateTime          @default(now())
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reports        GeneratedReport[]

  @@unique([organizationId, key, version])
}

/// A rendered institution report. `dataSnapshot` freezes every number used, so later data
/// changes never alter an issued version.
model GeneratedReport {
  id              String          @id @default(cuid())
  organizationId  String
  templateId      String?
  templateVersion Int
  title           String
  programIds      String[]
  periodStart     DateTime
  periodEnd       DateTime
  version         Int
  status          ReportStatus    @default(PENDING)
  dataSnapshot    Json?
  narrative       Json?
  narrativeSource String?
  aiAnalysisId    String?
  storageKey      String?         @unique
  sha256          String?
  sizeBytes       Int?
  error           String?
  createdById     String?
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model TalentSearch {
  id             String        @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  criteria       Json
  scoringVersion String
  candidateCount Int           @default(0)
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  results        MatchResult[]

  @@index([organizationId, createdAt])
}

/// Rule-based match score with its breakdown and cited data. The LLM only writes `explanation`.
model MatchResult {
  id                String         @id @default(cuid())
  searchId          String
  candidateId       String
  rank              Int
  score             Int
  breakdown         Json
  evidence          Json
  explanation       String?
  explanationSource String?
  explanationModel  String?
  scoringVersion    String
  feedback          MatchFeedback?
  feedbackAt        DateTime?
  feedbackById      String?
  createdAt         DateTime       @default(now())
  search            TalentSearch   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  candidate         User           @relation("MatchCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  feedbackBy        User?          @relation("MatchFeedbackBy", fields: [feedbackById], references: [id], onDelete: SetNull)

  @@unique([searchId, candidateId])
  @@index([candidateId])
}

model Organization {
  id                 String                         @id @default(cuid())
  name               String
  type               OrganizationType
  description        String?
  website            String?
  contactEmail       String?
  registrationNumber String?
  verificationStatus OrganizationVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  createdBy          User?                          @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members            OrganizationMember[]
  verifications      OrganizationVerification[]
  programs           Program[]
  verifiedRecords    VerifiedRecord[]
  aiUsageLogs        AIUsageLog[]
  reportTemplates    ReportTemplate[]
  reports            GeneratedReport[]
  talentSearches     TalentSearch[]

  @@index([verificationStatus])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole         @default(MEMBER)
  status         OrganizationMemberStatus @default(PENDING)
  title          String?
  message        String?
  joinedAt       DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationVerification {
  id             String                         @id @default(cuid())
  organizationId String
  submittedById  String?
  documentType   OrganizationDocumentType
  documentName   String?
  documentUrl    String
  note           String?
  status         OrganizationVerificationStatus @default(PENDING)
  reviewedById   String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime                       @default(now())
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy    User?                          @relation("VerificationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy     User?                          @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([status])
}

model Program {
  id              String               @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  term            String?
  status          ProgramStatus        @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  /// Target values per KPI key (see programKpis.ts). Goal achievement = targets met / targets set.
  kpiTargets      Json?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: SetNull)
  managers        ProgramManager[]
  participants    ProgramParticipant[]
  projects        Project[]
  verifiedRecords VerifiedRecord[]

  @@index([organizationId])
}

/// Staff assigned to run a program (e.g. the professor of a capstone course).
model ProgramManager {
  id        String   @id @default(cuid())
  programId String
  userId    String
  createdAt DateTime @default(now())
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
}

/// Students registered to a program as a whole, before/independently of team assignment.
model ProgramParticipant {
  id         String   @id @default(cuid())
  programId  String
  userId     String
  studentNo  String?
  department String?
  addedById  String?
  createdAt  DateTime @default(now())
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  user       User     @relation("ProgramParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy    User?    @relation("ProgramParticipantAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([programId, userId])
  @@index([userId])
}

model ProjectEvidence {
  id             String           @id @default(cuid())
  projectId      String
  authorId       String
  title          String
  description    String?
  category       EvidenceCategory @default(OTHER)
  activityDate   DateTime
  status         EvidenceStatus   @default(DRAFT)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         User             @relation("EvidenceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  files          EvidenceFile[]
  reviews        EvidenceReview[]
  verifiedRecord VerifiedRecord?

  @@index([projectId, status])
  @@index([authorId])
}

model EvidenceFile {
  id           String           @id @default(cuid())
  evidenceId   String
  uploaderId   String?
  originalName String
  storageKey   String           @unique
  mimeType     String
  kind         EvidenceFileKind
  sizeBytes    Int
  sha256       String
  scanStatus   String
  createdAt    DateTime         @default(now())
  evidence     ProjectEvidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  uploader     User?            @relation("EvidenceFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([evidenceId])
}

/// Append-only audit trail of evidence status changes.
model EvidenceReview {
  id         String               @id @default(cuid())
  evidenceId String
  actorId    String?
  action     EvidenceReviewAction
  note       String?
  createdAt  DateTime             @default(now())
  evidence   ProjectEvidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  actor      User?                @relation("EvidenceReviewActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([evidenceId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}
